# Copy this file to .env and change the values before starting the stack.

# Host directory that stores images, the SQLite index, thumbnails and tokens.
# Relative paths are resolved from the compose file.
PIXIV_DATA_DIR=./data

# Container user.  It must be able to write to PIXIV_DATA_DIR.
# Find yours with: id -u && id -g
PUID=1000
PGID=1000

# Where the viewer listens on the host.
# 127.0.0.1 is the safest default.  Use 0.0.0.0 for LAN/Tailscale access,
# or a single interface address such as 100.x.y.z.
VIEWER_BIND=127.0.0.1
VIEWER_PORT=8899

# Required in practice.  Generate a session secret with:
#   openssl rand -hex 32
VIEWER_PASSWORD=change-me
VIEWER_SECRET=change-me-too

SYNC_INTERVAL_MINUTES=15
TZ=Asia/Tokyo
